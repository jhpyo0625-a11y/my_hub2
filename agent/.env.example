# 복사: cp .env.example .env  후 값 채우기. .env는 커밋 금지(.gitignore 처리됨).

# OpenAI 호환 엔드포인트. API_KEY 비우면 Planner는 결정적 fallback 계획 사용.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Neon PostgreSQL 연결 문자열
DATABASE_URL=

# 로컬 MCP 서버. 비우면 http://localhost:8080 사용.
MCP_SERVER_URL=http://localhost:8080

# Reviewer 재시도 최대 횟수. 비우면 3 사용.
MAX_RETRIES=3

# compliance 리포트 설명 산문을 LLM으로 생성할지. 기본 0(OFF).
# 0: 숫자/표는 물론 전체 리포트를 Jinja가 결정적으로 렌더(네트워크 미사용, 테스트 경로).
# 1: 위 결정적 렌더에 더해 LLM이 한국어 설명 산문만 추가. 이때도 숫자는 엔진 유래만
#    허용되며(부분집합 검증), 위반/실패/키없음 시 산문을 폐기하고 결정적 렌더로 폴백.
COMPLIANCE_LLM_PROSE=0
