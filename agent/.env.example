# 복사: cp .env.example .env  후 값 채우기. .env는 커밋 금지(.gitignore 처리됨).

# OpenAI 호환 엔드포인트. API_KEY 비우면 Planner는 결정적 fallback 계획 사용.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Neon PostgreSQL 연결 문자열
DATABASE_URL=

# 로컬 MCP 서버. 비우면 http://localhost:8080 사용.
MCP_SERVER_URL=http://localhost:8080
